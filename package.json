  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owl-agent/owl-agent"
  },
  "engines": {
    "python": ">=3.9"
  },
  "dependencies": {
    "proxybroker2": "^2.0.0",
    "litproxy": "^0.2.0",
    "resilient-httpx": "^1.1.0",
    "circuitbreaker": "^2.0.0",
    "curl_cffi": "^0.15.0",
    "httpx": "^0.28.0",
    "aiohttp": "^3.14.0",
    "aiofiles": "^25.0.0",
    "redis": "^8.0.0"
  },
  "files": [
    "proxy_defense.py",
