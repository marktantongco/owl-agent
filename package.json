{
  "name": "owl-agent",
  "version": "4.2.0",
  "description": "Self-optimising HTTP scraping engine with 50+ proxy sources, quality scoring, adaptive rate limiting, and Chrome fingerprinting",
  "main": "proxy_defense.py",
  "scripts": {
